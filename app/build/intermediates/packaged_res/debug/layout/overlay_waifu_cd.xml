<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown overlay - ringan, selalu tampil saat waifu notifier aktif -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <!-- Foto waifu bulat dengan garis halus -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <!-- Garis halus di luar lingkaran -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00000000" />

        </androidx.cardview.widget.CardView>

        <!-- Foto waifu bulat (background transparan) -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#00000000">

            <ImageView
                android:id="@+id/ivCdWaifu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/waifu_low_1"
                android:scaleType="fitCenter" />

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Teks semangat -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Semangat sayang mainnya!"
        android:textColor="#FFFFFF"
        android:textSize="6sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:maxLines="1" />

</LinearLayout>
