<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_fps_overlay"
    android:padding="4dp"
    android:gravity="center">

    <!-- MODE 185 / 145: hanya angka FPS, label XGPU ENGINE hijau full -->
    <LinearLayout
        android:id="@+id/layoutSimpleFps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvFpsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="180"
            android:textColor="#00FF88"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS"
            android:textColor="#888888"
            android:textSize="7sp"
            android:gravity="center"
            android:layout_marginTop="-3dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XGPU ENGINE"
            android:textColor="#00FF88"
            android:textSize="6sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center" />

    </LinearLayout>

    <!-- MODE GRAFIK: horizontal layout - graph kiri, fps kanan -->
    <LinearLayout
        android:id="@+id/layoutGraphFps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Top row: graph LEFT + fps numbers RIGHT horizontal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- Graph on left -->
            <com.xgpu.engine.overlay.FpsGraphView
                android:id="@+id/fpsGraphView"
                android:layout_width="52dp"
                android:layout_height="29dp"
                android:layout_marginEnd="5dp" />

            <!-- Vertical divider -->
            <View
                android:layout_width="0.5dp"
                android:layout_height="29dp"
                android:background="#33FFFFFF"
                android:layout_marginEnd="5dp" />

            <!-- FPS numbers on right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Real FPS (green) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● "
                        android:textColor="#00FF88"
                        android:textSize="5sp" />

                    <TextView
                        android:id="@+id/tvGameFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120"
                        android:textColor="#00FF88"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real FPS"
                        android:textColor="#00FF88"
                        android:textSize="5sp" />

                </LinearLayout>

                <!-- Gen FPS (cyan) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● "
                        android:textColor="#00CFFF"
                        android:textSize="5sp" />

                    <TextView
                        android:id="@+id/tvFakeFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="185"
                        android:textColor="#00CFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gen FPS"
                        android:textColor="#00CFFF"
                        android:textSize="5sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="3dp" />

        <!-- Bottom row: Battery | Temp | Time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <!-- Battery -->
            <TextView
                android:id="@+id/tvBatteryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋89%"
                android:textColor="#FFFFFF"
                android:textSize="6sp"
                android:layout_marginEnd="3dp" />

            <!-- Temp divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#33FFFFFF"
                android:textSize="6sp"
                android:layout_marginEnd="3dp" />

            <!-- Temperature -->
            <TextView
                android:id="@+id/tvTempInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️33°C"
                android:textColor="#FFFFFF"
                android:textSize="6sp"
                android:layout_marginEnd="3dp" />

            <!-- Time divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#33FFFFFF"
                android:textSize="6sp"
                android:layout_marginEnd="3dp" />

            <!-- Time -->
            <TextView
                android:id="@+id/tvTimeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕔00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="7sp" />

        </LinearLayout>

        <!-- XGPU ENGINE label -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LSFG "
                android:textColor="#00CFFF"
                android:textSize="5.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE"
                android:textColor="#00FF88"
                android:textSize="5.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
